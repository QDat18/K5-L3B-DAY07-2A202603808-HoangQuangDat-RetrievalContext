# Cấu hình môi trường cho Day 7
# Sao chép file này thành .env và điền các giá trị thực tế của bạn:

# 1. NVIDIA NIM API Key (bắt đầu bằng nvapi-...)
NVIDIA_API_KEY=your_nvidia_api_key_here

# 2. Kết nối PostgreSQL Day 6 (mặc định của Docker Compose Day 6)
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab

